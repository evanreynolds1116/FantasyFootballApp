DATABASE_URL=
PORT=3000
# Where sign-in links point (the web app's address).
APP_URL=http://localhost:5173
# The no-check name/email login for local testing and bot scripts. Never true in production.
DEV_LOGIN=true
# Sign-in emails: set these to send through Resend; otherwise emails are printed to the server console.
RESEND_API_KEY=
MAIL_FROM=Draft Day <signin@yourdomain.com>
